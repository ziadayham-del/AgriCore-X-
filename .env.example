# ==============================================================================
# SmartAgriculture X - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your .env file containing real API keys to GitHub!
# ==============================================================================

# Supabase Cloud Database & Realtime Telemetry
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# Groq Cloud AI Inference (Server-side LPU proxy for precision agronomic advisory)
GROQ_API_KEY="your_groq_api_key_here"

# Hardware Node & ESP32 Server Configuration
VITE_API_BASE_URL="http://192.168.1.100/api"
VITE_WS_URL="ws://192.168.1.100/ws"

# Simulation / Demo Mode (Set to 'true' for standalone browser demo without hardware)
VITE_DEMO_MODE="true"

# Server Port (Defaults to 3000)
PORT=3000
